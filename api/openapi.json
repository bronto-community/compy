{
  "openapi": "3.0.3",
  "info": {
    "title": "compy",
    "description": "Local OpenTelemetry Collector manager: REST API served by whatever UI process is running (compy ui / window / tray). Localhost-only; see internal/webui's host-check + CSRF middleware.",
    "version": "3.0.0"
  },
  "servers": [
    { "url": "http://127.0.0.1:8080" }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "still_running": {
            "type": "string",
            "description": "Present when an activation failed and the previous configuration was put back, e.g. \"otlp-to-bronto · staging\"."
          }
        },
        "required": ["error"]
      },
      "Status": {
        "type": "object",
        "properties": {
          "running": { "type": "boolean" },
          "distro": { "type": "string" },
          "grpc_port": { "type": "integer" },
          "http_port": { "type": "integer" },
          "endpoint": { "type": "string" },
          "config": { "type": "string" },
          "preset": { "type": "string" },
          "os_env": { "type": "boolean" },
          "recent": {
            "type": "array",
            "description": "Configurations that have run, most recent first (the menu bar's ordering).",
            "items": { "type": "string" }
          },
          "listening": {
            "type": "array",
            "description": "TCP ports the collector process is actually listening on, detected from the OS (launchd pid + lsof), sorted ascending. Absent when stopped or undetectable — never derived from settings or YAML.",
            "items": { "type": "integer" }
          }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "grpc_port": { "type": "integer" },
          "http_port": { "type": "integer" }
        }
      },
      "SettingsUpdate": {
        "type": "object",
        "description": "Partial: an absent field leaves that setting unchanged. Port changes take effect on next apply.",
        "properties": {
          "grpc_port": { "type": "integer" },
          "http_port": { "type": "integer" }
        }
      },
      "Var": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "default": { "type": "string" },
          "has_default": { "type": "boolean" },
          "description": { "type": "string" }
        }
      },
      "Info": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "provenance": { "type": "string", "enum": ["shipped", "remote", "local"] },
          "modified": { "type": "boolean" },
          "meta": {
            "type": "object",
            "properties": {
              "remote_url": { "type": "string" },
              "pristine_sha256": { "type": "string" },
              "presets": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                }
              },
              "active_preset": { "type": "string" }
            }
          },
          "vars": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Var" }
          }
        }
      },
      "ConfigDetail": {
        "type": "object",
        "properties": {
          "info": { "$ref": "#/components/schemas/Info" },
          "yaml": { "type": "string" }
        }
      },
      "Distro": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "selected": { "type": "boolean" },
          "definition": { "type": "boolean" },
          "available": { "type": "boolean" },
          "downloaded": { "type": "boolean" },
          "user_entry": {
            "type": "boolean",
            "description": "True iff this name has an actual entry in the user distro registry (distros.json) — a custom distro, or an override of a shipped definition's path. False for a shipped definition that's merely been downloaded to its default path: there's no registry entry for DELETE /api/distros/{name} to remove."
          },
          "download": {
            "$ref": "#/components/schemas/DownloadProgress",
            "description": "Present only while a download of this distro is in flight in the serving process — including one an activation started automatically (the default collector fetched on first need), so the settings screen's periodic refresh can show a progress bar for a download it did not start."
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "available": { "type": "boolean" },
          "port": { "type": "integer", "description": "The localhost port whose /metrics answered this scrape. Absent when unavailable." },
          "received": { "type": "integer" },
          "exported": { "type": "integer" },
          "queue": { "type": "integer" },
          "dropped": { "type": "integer" }
        },
        "required": ["available"]
      },
      "DownloadProgress": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["idle", "downloading", "done", "failed"] },
          "pct": { "type": "integer" },
          "error": { "type": "string" }
        },
        "required": ["status", "pct"]
      },
      "Ok": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" } }
      }
    }
  },
  "paths": {
    "/api/status": {
      "get": {
        "summary": "Service state, distro, ports, active config",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } }
          }
        }
      }
    },
    "/api/log": {
      "get": {
        "summary": "Tail of the collector log",
        "parameters": [
          {
            "name": "lines",
            "in": "query",
            "required": false,
            "description": "Number of lines (default 50, clamped to 2000)",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "log": { "type": "string" } }
                }
              }
            }
          },
          "400": {
            "description": "Invalid lines value",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/env": {
      "get": {
        "summary": "OTEL_* environment variables compy exposes",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vars": { "type": "object", "additionalProperties": { "type": "string" } },
                    "script": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/os-env": {
      "post": {
        "summary": "Enable/disable OS-level (launchctl setenv) injection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "on": { "type": "boolean" } },
                "required": ["on"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Current settings",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Settings" } } }
          }
        }
      },
      "put": {
        "summary": "Update settings (partial)",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SettingsUpdate" } }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Settings" } } }
          },
          "400": {
            "description": "Malformed body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/collector/health": {
      "get": {
        "summary": "The collector's own metrics, scraped from its telemetry endpoint",
        "description": "Four numbers for the Collector screen. localhost:8888 (otelcol's default) is tried first; if it does not answer, the collector's detected listening ports are probed and the first parsable /metrics wins — `port` names the winner. A stopped or unscrapable collector answers 200 with available:false and zeroes, never an error. Sources (otelcol 0.135, counters matched with or without a _total suffix): received = otelcol_receiver_accepted_{spans,metric_points,log_records}; exported = otelcol_exporter_sent_{spans,metric_points,log_records}; queue = otelcol_exporter_queue_size; dropped = otelcol_receiver_refused_*, otelcol_exporter_send_failed_*, otelcol_exporter_enqueue_failed_*.",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/service/apply": {
      "post": {
        "summary": "Re-activate the current configuration and set",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/service/stop": {
      "post": {
        "summary": "Stop the collector (the active configuration stays named)",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/service/start": {
      "post": {
        "summary": "Run the active configuration again",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 no active configuration, or one the collector rejects",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error \u2014 the collector did not come up; \"still_running\" names what was put back",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/service/validate": {
      "post": {
        "summary": "Validate the active configuration against its distro without touching the running service",
        "responses": {
          "200": {
            "description": "Valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          },
          "500": {
            "description": "Invalid (the collector's own diagnostics)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/factory-reset": {
      "post": {
        "summary": "Reset compy to factory settings: uninstall the collector job, wipe the state directory's contents, and re-create the shipped defaults (the tray's own agent is untouched)",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs": {
      "get": {
        "summary": "List configurations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Info" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a configuration (blank template if yaml is absent)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "yaml": { "type": "string" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Malformed body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/from-url": {
      "post": {
        "summary": "Create a configuration from a remote YAML URL",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "url": { "type": "string" }
                },
                "required": ["name", "url"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Malformed body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}": {
      "get": {
        "summary": "One configuration's info and YAML",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConfigDetail" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "delete": {
        "summary": "Delete a configuration (the active one may not be deleted)",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/yaml": {
      "put": {
        "summary": "Replace a configuration's YAML",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": { "text/plain": { "schema": { "type": "string" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/meta": {
      "put": {
        "summary": "Update a configuration's metadata (partial)",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "remote_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Malformed body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/copy": {
      "post": {
        "summary": "Duplicate a configuration under a new name",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "dst": { "type": "string" } },
                "required": ["dst"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Malformed body",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "Body too large",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/activate": {
      "post": {
        "summary": "Make this configuration the running one",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "preset": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/validate": {
      "post": {
        "summary": "Validate this configuration against its own distro, using its own active set's environment (any config, not just the active one)",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean" } }
                }
              }
            }
          },
          "500": {
            "description": "Invalid (the collector's own diagnostics, verbatim)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/sync": {
      "post": {
        "summary": "Refetch a remote configuration (refuses if locally modified)",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/resync": {
      "post": {
        "summary": "Refetch a remote configuration, discarding local edits",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Ok" } } }
          },
          "400": {
            "description": "Bad request \u2014 a caller mistake (invalid name, unknown configuration or preset, a configuration the collector rejects, a binary that isn't there)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/configs/{name}/reset": {
      "post": {
        "summary": "Restore a modified built-in configuration to its shipped version (presets kept; the running configuration is re-applied)",
        "parameters": [
