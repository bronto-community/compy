    "/api/distros/{name}/progress": {
      "get": {
        "summary": "How this collector binary's download is going",
        "description": "Poll after POST .../fetch, which returns immediately. status is idle | downloading | done | failed; pct is 0-100 (and stays put when the server declares no Content-Length); error is present only when status is failed. Progress is per-process and in memory: a name nobody has fetched since this process started reads idle, whether or not the binary is on disk.",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DownloadProgress" } } }
          },
          "500": {
            "description": "Error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/api/distros/{name}/fetch": {
      "post": {
        "summary": "Start downloading a shipped distro definition's binary (returns at once; poll .../progress)",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Accepted \u2014 the download has started (or the binary was already present). Nothing else is reported here: an unknown name, a checksum mismatch or a network failure all surface through .../progress as status \"failed\", since this request is long gone by then."
          }
        }
      }
    }
  }
