---
name: bronto
description: Send OTLP to Bronto.
sections:
  - id: pipeline
    label: Pipeline options
    collapsed: true
backends:
  min: 1
  max: 4
  fields:
    - name: region
      type: choice
      options: [eu, us]
      default: eu
      description: Bronto region; sets the ingestion endpoint
    - name: api_key
      type: secret
      label: API key
      description: Stored in the preset, referenced as ${env:<NAME>_API_KEY}
    - name: name
      type: slug
      default: bronto
      advanced: true
      description: Short name for this backend; the exporter and its API key variable derive from it
    - name: collection
      type: string
      optional: true
      default: ""
      advanced: true
      description: Sent as the x-bronto-collection header; empty sends none
    - name: dataset
      type: string
      optional: true
      default: ""
      advanced: true
      description: Sent as the x-bronto-dataset header; empty sends none
fields:
  - name: memory_limiter
    type: toggle
    default: true
    section: pipeline
    description: Cap the collector's memory use
  - name: batch
    type: toggle
    default: true
    section: pipeline
    description: Batch before export
  - name: offline_queue
    type: toggle
    default: true
    section: pipeline
    description: Store telemetry on disk and retry until Bronto accepts it
---
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:${env:COMPY_GRPC_PORT:-14317}  # compy's local gRPC port
      http:
        endpoint: 127.0.0.1:${env:COMPY_HTTP_PORT:-14318}  # compy's local HTTP port

{{if .AnyProcs}}processors:
{{if .MemoryLimiter}}  memory_limiter:
    check_interval: 1s
    limit_percentage: 80
    spike_limit_percentage: 20
{{end}}{{if .Batch}}  batch:
    send_batch_size: 1024
    send_batch_max_size: 1024
    timeout: 200ms
{{end}}
{{end}}exporters:
{{range .Backends}}  otlphttp/{{.Name}}:
    endpoint: https://ingestion.{{.Row.region}}.bronto.io
    headers:
      X-BRONTO-API-KEY: ${env:{{.EnvVar}}}  # {{.Name}} api key
{{if .Row.collection}}      x-bronto-collection: {{.Row.collection}}
{{end}}{{if .Row.dataset}}      x-bronto-dataset: {{.Row.dataset}}
{{end}}{{if $.OfflineQueue}}    sending_queue:
      storage: file_storage  # survives restarts and offline stretches
    retry_on_failure:
      max_elapsed_time: 0  # retry forever; the queue holds telemetry until Bronto answers
{{end}}{{end}}
{{if .OfflineQueue}}extensions:
  file_storage:
    directory: "{{.StorageDir}}"
    create_directory: true

{{end}}service:
{{if .OfflineQueue}}  extensions: [file_storage]
{{end}}  pipelines:
    traces:
      receivers: [otlp]
{{if .TracesProcs}}      processors: [{{.TracesProcs}}]
{{end}}      exporters: [{{.TracesExps}}]
{{range .MetricsGroups}}    {{.Pipeline}}:
      receivers: [otlp]
{{if .Procs}}      processors: [{{.Procs}}]
{{end}}      exporters: [{{.Exps}}]
{{end}}    logs:
      receivers: [otlp]
{{if .LogsProcs}}      processors: [{{.LogsProcs}}]
{{end}}      exporters: [{{.LogsExps}}]
