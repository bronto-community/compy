---
name: otlp-forward
description: Receive OTLP locally and forward it to one or more backends over HTTP.
sections:
  - id: pipeline
    label: Pipeline options
    collapsed: true
groups:
  - id: backends
    label: Backends
    item: backend
    min: 1
    max: 8
    fields:
      - name: endpoint
        type: url
        default: http://127.0.0.1:4318
        description: Base OTLP/HTTP URL, e.g. https://api.example.com. The collector appends /v1/traces etc.
      - name: api_key
        type: secret
        label: Auth value
        optional: true
        description: Stored in this preset, never in the config. Sent as a bearer token unless you change the header below.
      - name: auth_header
        type: string
        default: Authorization
        advanced: true
        description: Header that carries the auth value. Authorization sends "Bearer <value>"; any other header sends the value as-is. Empty sends no auth header at all.
fields:
  - name: memory_limiter
    type: toggle
    default: true
    section: pipeline
    description: Cap the collector's memory use
  - name: batch
    type: toggle
    default: true
    section: pipeline
    description: Batch before export
  - name: offline_queue
    type: toggle
    default: false
    section: pipeline
    description: Store telemetry on disk and retry until the backend accepts it
---
{{- $procs := list -}}
{{- if .memory_limiter}}{{$procs = append $procs "memory_limiter"}}{{end -}}
{{- if .batch}}{{$procs = append $procs "batch"}}{{end -}}
{{- $exp := list -}}
{{- range .backends}}{{$exp = append $exp (printf "otlphttp/%s" ._slug)}}{{end -}}
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:${env:COMPY_GRPC_PORT:-14317}  # compy's local gRPC port
      http:
        endpoint: 127.0.0.1:${env:COMPY_HTTP_PORT:-14318}  # compy's local HTTP port
{{if $procs}}
processors:
{{- if .memory_limiter}}
  memory_limiter:
    check_interval: 1s
    limit_percentage: 80
    spike_limit_percentage: 20
{{- end}}
{{- if .batch}}
  batch:
    send_batch_size: 1024
    send_batch_max_size: 1024
    timeout: 200ms
{{- end}}
{{end}}
exporters:
{{- range .backends}}
  otlphttp/{{._slug}}:
    endpoint: {{.endpoint}}
{{- if .auth_header}}
    headers:
      {{.auth_header}}: {{if eq .auth_header "Authorization"}}Bearer {{end}}${env:{{._env.api_key}}:-}  # {{._label}} auth value
{{- end}}
{{- if $.offline_queue}}
    sending_queue:
      storage: file_storage  # survives restarts and offline stretches
    retry_on_failure:
      max_elapsed_time: 0  # retry forever; the queue holds telemetry until the backend answers
{{- end}}
{{- end}}
{{if .offline_queue}}
extensions:
  file_storage:
    directory: "{{.StorageDir}}"
    create_directory: true
{{end}}
service:
{{- if .offline_queue}}
  extensions: [file_storage]
{{- end}}
  pipelines:
    traces:
      receivers: [otlp]
{{- if $procs}}
      processors: [{{join $procs ", "}}]
{{- end}}
      exporters: [{{join $exp ", "}}]
    metrics:
      receivers: [otlp]
{{- if $procs}}
      processors: [{{join $procs ", "}}]
{{- end}}
      exporters: [{{join $exp ", "}}]
    logs:
      receivers: [otlp]
{{- if $procs}}
      processors: [{{join $procs ", "}}]
{{- end}}
      exporters: [{{join $exp ", "}}]
