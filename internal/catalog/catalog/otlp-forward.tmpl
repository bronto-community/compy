---
name: otlp-forward
description: Forward OTLP to one or more backends over HTTP.
sections:
  - id: pipeline
    label: Pipeline options
    collapsed: true
backends:
  min: 1
  max: 8
  fields:
    - name: endpoint
      type: url
      default: http://127.0.0.1:4318
      description: Base OTLP/HTTP URL, e.g. https://api.example.com. The collector appends /v1/traces etc.
    - name: auth_header
      type: string
      optional: true
      description: Header that carries the auth value, e.g. x-example-key or Authorization; leave empty for no auth
    - name: api_key
      type: secret
      label: Auth value
      description: Stored in the preset, referenced as ${env:<NAME>_API_KEY}
    - name: name
      type: slug
      default: local
      advanced: true
      description: Short name for this backend; the exporter and its auth variable derive from it
fields:
  - name: memory_limiter
    type: toggle
    default: true
    section: pipeline
    description: Cap the collector's memory use
  - name: batch
    type: toggle
    default: true
    section: pipeline
    description: Batch before export
  - name: offline_queue
    type: toggle
    default: false
    section: pipeline
    description: Store telemetry on disk and retry until the backend accepts it
---
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:${env:COMPY_GRPC_PORT:-14317}  # compy's local gRPC port
      http:
        endpoint: 127.0.0.1:${env:COMPY_HTTP_PORT:-14318}  # compy's local HTTP port

{{if .AnyProcs}}processors:
{{if .MemoryLimiter}}  memory_limiter:
    check_interval: 1s
    limit_percentage: 80
    spike_limit_percentage: 20
{{end}}{{if .Batch}}  batch:
    send_batch_size: 1024
    send_batch_max_size: 1024
    timeout: 200ms
{{end}}
{{end}}exporters:
{{range .Backends}}  otlphttp/{{.Name}}:
    endpoint: {{.Endpoint}}
{{if .AuthHeader}}    headers:
      {{.AuthHeader}}: ${env:{{.EnvVar}}}  # {{.Name}} auth value
{{end}}{{if $.OfflineQueue}}    sending_queue:
      storage: file_storage  # survives restarts and offline stretches
    retry_on_failure:
      max_elapsed_time: 0  # retry forever; the queue holds telemetry until the backend answers
{{end}}{{end}}
{{if .OfflineQueue}}extensions:
  file_storage:
    directory: "{{.StorageDir}}"
    create_directory: true

{{end}}service:
{{if .OfflineQueue}}  extensions: [file_storage]
{{end}}  pipelines:
    traces:
      receivers: [otlp]
{{if .TracesProcs}}      processors: [{{.TracesProcs}}]
{{end}}      exporters: [{{.TracesExps}}]
{{range .MetricsGroups}}    {{.Pipeline}}:
      receivers: [otlp]
{{if .Procs}}      processors: [{{.Procs}}]
{{end}}      exporters: [{{.Exps}}]
{{end}}    logs:
      receivers: [otlp]
{{if .LogsProcs}}      processors: [{{.LogsProcs}}]
{{end}}      exporters: [{{.LogsExps}}]
